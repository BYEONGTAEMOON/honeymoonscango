generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  month           String?
  destination     String?
  budget          String?
  duration        String?
  region          String?
  name            String?
  phone           String?
  selectedResorts String?  @map("selected_resorts")
  status          String   @default("신규")
  memo            String?
  ip              String?  @map("ip_address")

  @@index([ip])
  @@map("leads")
}

model BlockedIp {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_ips")
}

model ChatbotConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chatbot_config")
}

model AdminAccount {
  id           Int      @id @default(1)
  username     String
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_account")
}

model NotificationRecipient {
  id        Int      @id @default(autoincrement())
  type      String // "email" | "sms"
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([type, value])
  @@map("notification_recipients")
}

model NotificationSettings {
  id        Int      @id @default(1)
  smsSender String?  @map("sms_sender") // SOLAPI-registered caller ID, e.g. "01012345678"
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

// Read-only staff logins: can see the dashboard and leads only. The main
// admin is still the single AdminAccount row (or the env-var fallback).
model SubAdmin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sub_admins")
}
