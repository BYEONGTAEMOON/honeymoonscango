# Postgres connection string. On Vercel: Project → Storage → Create Database → Prisma Postgres.
# Vercel injects this automatically once connected — no manual copy/paste needed.
# After it's set, run `npx prisma db push` once to create the tables (see prisma/schema.prisma).
DATABASE_URL=

# Admin login credentials for /admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Email notifications on new leads (resend.com). Optional — the admin
# "알림 설정" page just shows "미설정" and skips email if this is unset.
RESEND_API_KEY=
# Defaults to onboarding@resend.dev (Resend's test sender, which only
# delivers to the Resend account's own address). Verify a domain in Resend
# and set this to a real address on it to notify arbitrary recipients.
RESEND_FROM=

# SMS notifications on new leads (solapi.com). Optional — the admin
# "알림 설정" page just shows "미설정" and skips SMS if this is unset.
# The sender/caller-ID number itself is set from the admin UI, not here,
# since SOLAPI requires it to be pre-registered per account anyway.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
