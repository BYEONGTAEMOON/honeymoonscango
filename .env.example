# Postgres connection string. On Vercel: Project → Storage → Create Database → Postgres (Neon).
# Vercel injects this automatically once connected — no manual copy/paste needed.
DATABASE_URL=

# Admin login credentials for /admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
